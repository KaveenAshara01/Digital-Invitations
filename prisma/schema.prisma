generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  invitations   Invitation[]
  mediaAssets   MediaAsset[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
}

model Template {
  id String @id
  slug String @unique
  name String
  description String
  category String
  previewImage String
  active Boolean @default(true)
  versions TemplateVersion[]
}

model TemplateVersion {
  id String @id
  templateId String
  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version Int
  definition Json @db.JsonB
  createdAt DateTime @default(now())
  invitations Invitation[]
  publications Publication[]
  @@unique([templateId, version])
}

// Drafts and their immutable publication snapshots. Guest management follows in Phase 5.
model Invitation {
  id            String           @id @default(cuid())
  ownerId       String
  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title         String
  status        InvitationStatus @default(DRAFT)
  configuration Json             @default("{}") @db.JsonB
  templateVersionId String?
  templateVersion TemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  revision Int @default(0)
  media MediaReference[]
  publicSlug String? @unique
  publicationId String? @unique
  publication Publication? @relation("CurrentPublication", fields: [publicationId], references: [id], onDelete: SetNull)
  publications Publication[] @relation("Snapshots")
  guests Guest[]
  simulatedPaymentAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([ownerId, updatedAt])
}

model MediaAsset {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key String @unique
  name String
  mime String
  size Int
  artist String?
  license String?
  loop Boolean @default(false)
  ready Boolean @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  references MediaReference[]
  publications PublicationMedia[]
  @@index([ownerId, createdAt])
}

model MediaReference {
  invitationId String
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  assetId String
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@id([invitationId, assetId])
}

model Publication {
  id String @id @default(cuid())
  invitationId String
  invitation Invitation @relation("Snapshots", fields: [invitationId], references: [id], onDelete: Cascade)
  currentFor Invitation? @relation("CurrentPublication")
  templateVersionId String
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  configuration Json @db.JsonB
  revision Int
  createdAt DateTime @default(now())
  media PublicationMedia[]
  @@index([invitationId, createdAt])
}

model PublicationMedia {
  publicationId String
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  assetId String
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@id([publicationId, assetId])
}

model Guest {
  id String @id @default(cuid())
  invitationId String
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  name String
  email String?
  token String @unique @default(uuid())
  partySize Int @default(1)
  response String @default("PENDING")
  attending Int @default(0)
  note String @default("")
  respondedAt DateTime?
  responseWindow DateTime?
  responseAttempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([invitationId, createdAt])
}
